{
  "name": "hidamari-fukushi-keikaku",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "description": "Build tooling for the Hidamari Fukushi Keikaku static site.",
  "scripts": {
    "build:css": "powershell -NoProfile -ExecutionPolicy Bypass -File ./tools/build-css.ps1",
    "build:css:main": "powershell -NoProfile -ExecutionPolicy Bypass -File ./tools/build-css.ps1 main",
    "build:css:scss": "powershell -NoProfile -ExecutionPolicy Bypass -File ./tools/build-css.ps1 scss",
    "build:css:min": "powershell -NoProfile -ExecutionPolicy Bypass -File ./tools/build-css.ps1 min",
    "watch:css": "powershell -NoProfile -ExecutionPolicy Bypass -File ./tools/watch-css.ps1"
  },
  "devDependencies": {
    "autoprefixer": "^10.5.2",
    "postcss": "^8.5.16",
    "postcss-cli": "^11.0.1",
    "sass": "^1.101.0"
  }
}
